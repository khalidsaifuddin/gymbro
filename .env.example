# Local development only. Shell-compatible syntax for scripts/start-local.sh.
GYMBRO_DATABASE_URL='postgres://gymbro_local:gymbro-local-development-only@127.0.0.1:54329/gymbro_local?sslmode=disable'
GYMBRO_PUBLIC_URL='http://localhost:8080'
GYMBRO_HTTP_ADDR='127.0.0.1:8080'
