    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.2",
    "@expo/metro-runtime": "57.0.16"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "@types/react": "19.3.0",
    "@types/node": "26.6.4"
  }
}
